{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uni-stem-course-simulators:schema:bench-protocol:1.0",
  "title": "uniStemCourseSimulators bench-procedure protocol",
  "description": "A practice protocol for the bench simulator. Checkpoints and simulation-model parameters stay on the server; the browser receives the scenario, actions and limitations, and the checkpoint debrief only after a run ends. Every parameter states whether it is cited, a typical value chosen for the simulation, or part of the simulation's error model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "layer", "summary", "scenario", "guided_steps", "parameters", "actions", "checkpoints", "sources", "limitations"],
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": {"enum": ["cited", "simulation-typical", "simulation-model"]},
        "source_id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 3},
        "note": {"type": "string", "minLength": 3}
      },
      "if": {"properties": {"kind": {"const": "cited"}}},
      "then": {"required": ["source_id", "location"]}
    },
    "param": {
      "type": "object", "additionalProperties": false, "required": ["name", "label", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string", "minLength": 2},
        "type": {"enum": ["number", "integer", "boolean", "choice"]},
        "min": {"type": "number"}, "max": {"type": "number"}, "unit": {"type": "string"},
        "options": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["value", "label"],
          "properties": {"value": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}}}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "title": {"type": "string", "minLength": 5},
    "layer": {"type": "integer", "minimum": 0, "maximum": 5},
    "summary": {"type": "string", "minLength": 20},
    "scenario": {"type": "string", "minLength": 20},
    "guided_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "parameters": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "value", "unit", "label", "source"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "value": {"type": ["number", "string", "array"]},
        "unit": {"type": "string"}, "label": {"type": "string", "minLength": 2},
        "source": {"$ref": "#/$defs/source"}
      }}},
    "actions": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "label", "params"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string", "minLength": 3},
        "params": {"type": "array", "items": {"$ref": "#/$defs/param"}}
      }}},
    "checkpoints": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "severity", "description", "rationale", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "severity": {"enum": ["critical", "major", "minor"]},
        "description": {"type": "string", "minLength": 10},
        "rationale": {"type": "string", "minLength": 10},
        "source": {"$ref": "#/$defs/source"}
      }}},
    "sources": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "use"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "use": {"type": "string", "minLength": 10}}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}
  }
}
