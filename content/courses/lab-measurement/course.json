      "description": "Measure volume and mass with checked instruments, and quantify accuracy and precision from replicate measurements.",
      "bloom": "evaluate"
    },
    {
      "id": "lab-measurement-outcome-3",
      "description": "Calibrate and use a pH meter and a spectrophotometer, prepare buffers, and build and use standard curves.",
      "bloom": "apply"
    },
    {
      "id": "lab-measurement-outcome-4",
      "description": "Connect bench technique to measured results by rehearsing procedures and debriefing their errors.",
      "bloom": "analyze"
    }
  ],
  "lesson_objectives": [
    {
      "id": "lab-measurement-1-objective-1",
      "description": "Convert between molar, mass, percentage and parts-per-million concentrations, and state which quantity each fixes.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-1"
      ]
    },
    {
      "id": "lab-measurement-1-objective-2",
      "description": "Calculate the mass of a solid to weigh for a target concentration and volume, correcting for hydration and purity.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-1"
      ]
    },
    {
      "id": "lab-measurement-1-objective-3",
      "description": "Calculate the molarity of a concentrated liquid reagent from its mass percentage and density.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-1"
      ]
    },
    {
      "id": "lab-measurement-1-objective-4",
      "description": "Describe how to make a solution up to volume, and decide when to make a concentrated stock.",
      "bloom": "evaluate",
      "course_outcome_ids": [
        "lab-measurement-outcome-1"
      ]
    },
    {
      "id": "lab-measurement-2-objective-1",
      "description": "Use C₁V₁ = C₂V₂ to plan a single dilution and state the dilution factor unambiguously.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-1"
      ]
    },
    {
      "id": "lab-measurement-2-objective-2",
      "description": "Design a serial dilution series to reach a target dilution and compute the dilution of every tube.",
      "bloom": "create",
      "course_outcome_ids": [
        "lab-measurement-outcome-1",
        "lab-measurement-outcome-4"
      ]
    },
    {
      "id": "lab-measurement-2-objective-3",
      "description": "Back-calculate an original concentration from a count or reading in a diluted tube.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-1",
        "lab-measurement-outcome-4"
      ]
    },
    {
      "id": "lab-measurement-2-objective-4",
      "description": "Compare serial and parallel series and estimate how pipetting errors propagate along a series.",
      "bloom": "analyze",
      "course_outcome_ids": [
        "lab-measurement-outcome-1",
        "lab-measurement-outcome-2"
      ]
    },
    {
      "id": "lab-measurement-3-objective-1",
      "description": "Choose a volumetric device for a task, distinguishing devices calibrated to contain from those calibrated to deliver.",
      "bloom": "evaluate",
      "course_outcome_ids": [
        "lab-measurement-outcome-2"
      ]
    },
    {
      "id": "lab-measurement-3-objective-2",
      "description": "Distinguish systematic from random error and compute both from replicate measurements.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-2"
      ]
    },
    {
      "id": "lab-measurement-3-objective-3",
      "description": "Explain how air-displacement pipetting technique affects delivered volume, and when to reverse pipette.",
      "bloom": "understand",
      "course_outcome_ids": [
        "lab-measurement-outcome-2",
        "lab-measurement-outcome-4"
      ]
    },
    {
      "id": "lab-measurement-3-objective-4",
      "description": "Convert gravimetric readings of water to volume with the factor Z and judge a pipette against acceptance limits.",
      "bloom": "evaluate",
      "course_outcome_ids": [
        "lab-measurement-outcome-2",
        "lab-measurement-outcome-4"
      ]
    },
    {
      "id": "lab-measurement-4-objective-1",
      "description": "Distinguish readability from repeatability and compute a minimum weight.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-2"
      ]
    },
    {
      "id": "lab-measurement-4-objective-2",
      "description": "Describe the set-up and routine checks of an analytical balance and judge a check-weight reading.",
      "bloom": "evaluate",
      "course_outcome_ids": [
        "lab-measurement-outcome-2"
      ]
    },
    {
      "id": "lab-measurement-4-objective-3",
      "description": "Weigh by difference and explain when it is preferable to taring a boat.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-2"
      ]
    },
    {
      "id": "lab-measurement-4-objective-4",
      "description": "Identify the effects of temperature, draughts, static and buoyancy on weighing, and correct a mass for buoyancy.",
      "bloom": "analyze",
      "course_outcome_ids": [
        "lab-measurement-outcome-2"
      ]
    },
    {
      "id": "lab-measurement-5-objective-1",
      "description": "Calibrate a pH meter, compute the electrode slope as a percentage of theoretical, and accept or reject the calibration.",
      "bloom": "evaluate",
      "course_outcome_ids": [
        "lab-measurement-outcome-3"
      ]
    },
    {
      "id": "lab-measurement-5-objective-2",
      "description": "Convert an electrode reading in millivolts to pH from a calibration.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-3"
      ]
    },
    {
      "id": "lab-measurement-5-objective-3",
      "description": "Plan a buffer with the Henderson–Hasselbalch equation and explain why it must still be measured and adjusted.",
      "bloom": "apply",
      "course_outcome_ids": [
        "lab-measurement-outcome-3"
      ]
    },
    {
      "id": "lab-measurement-5-objective-4",
      "description": "Account for temperature in pH measurement: electrode slope, automatic compensation and buffer pKa.",
      "bloom": "analyze",
      "course_outcome_ids": [
        "lab-measurement-outcome-3"
      ]
    },
    {
      "id": "lab-measurement-6-objective-1",
      "description": "Relate absorbance, transmittance, path length and concentration through the Beer–Lambert law.",
