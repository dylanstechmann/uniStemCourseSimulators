{
  "schema_version": "1.0",
  "course_id": "lab-measurement",
  "cards": [
    {
      "id": "lab-measurement-1-card-1",
      "lesson_id": "lab-measurement-1",
      "front": "Molarity",
      "back": "Moles of solute per litre of final solution, not per litre of solvent added.",
      "objective_ids": [
        "lab-measurement-1-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-1-card-2",
      "lesson_id": "lab-measurement-1",
      "front": "Mass to weigh for a solution",
      "back": "m = C × V × M, using the molar mass of the material in the bottle (including water of hydration), divided by the assay fraction.",
      "objective_ids": [
        "lab-measurement-1-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-1-card-3",
      "lesson_id": "lab-measurement-1",
      "front": "Molarity of a concentrated reagent",
      "back": "C = 1000 × density × mass fraction/M; for 37% HCl at 1.18 g/mL, about 12.0 M.",
      "objective_ids": [
        "lab-measurement-1-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-1-card-4",
      "lesson_id": "lab-measurement-1",
      "front": "Making up to volume",
      "back": "Dissolve in about 70–80% of the final volume, adjust pH, transfer with rinses, then bring to the mark and mix.",
      "objective_ids": [
        "lab-measurement-1-objective-4"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-2-card-1",
      "lesson_id": "lab-measurement-2",
      "front": "Dilution factor",
      "back": "Final volume divided by sample volume; write volumes, because '1:4' is read both as one in four and one plus four.",
      "objective_ids": [
        "lab-measurement-2-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-2-card-2",
      "lesson_id": "lab-measurement-2",
      "front": "Serial dilution",
      "back": "Each tube made from the previous; constant factor f gives f⁻ⁿ after n steps.",
      "objective_ids": [
        "lab-measurement-2-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-2-card-3",
      "lesson_id": "lab-measurement-2",
      "front": "Back-calculation",
      "back": "Original concentration = count or reading ÷ (volume used × dilution of the tube).",
      "objective_ids": [
        "lab-measurement-2-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-2-card-4",
      "lesson_id": "lab-measurement-2",
      "front": "Error along a series",
      "back": "Random errors grow as e√n; systematic errors multiply, (1 + e)ⁿ − 1.",
      "objective_ids": [
        "lab-measurement-2-objective-4"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-3-card-1",
      "lesson_id": "lab-measurement-3",
      "front": "TC versus TD",
      "back": "TC glassware contains the stated volume; TD glassware delivers it when drained as specified.",
      "objective_ids": [
        "lab-measurement-3-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-3-card-2",
      "lesson_id": "lab-measurement-3",
      "front": "Systematic and random error",
      "back": "Systematic = (V̄ − V₀)/V₀ × 100; random (CV) = s/V̄ × 100. Averaging reduces only random error.",
      "objective_ids": [
        "lab-measurement-3-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-3-card-3",
      "lesson_id": "lab-measurement-3",
      "front": "Pre-wetting",
      "back": "Fill and empty a new tip a few times; the first fill of a dry tip delivers low.",
      "objective_ids": [
        "lab-measurement-3-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-3-card-4",
      "lesson_id": "lab-measurement-3",
      "front": "Factor Z",
      "back": "V = m × Z, Z = (1/(ρ_water − ρ_air))(1 − ρ_air/ρ_weights); about 1.003 µL/mg near room temperature.",
      "objective_ids": [
        "lab-measurement-3-objective-4"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-4-card-1",
      "lesson_id": "lab-measurement-4",
      "front": "Readability versus repeatability",
      "back": "Readability is the display step; repeatability is the measured scatter of repeated weighings and sets the uncertainty.",
      "objective_ids": [
        "lab-measurement-4-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-4-card-2",
      "lesson_id": "lab-measurement-4",
      "front": "Minimum weight",
      "back": "m_min = 2s/tolerance; below it the relative uncertainty of a weighing exceeds the tolerance.",
      "objective_ids": [
        "lab-measurement-4-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-4-card-3",
      "lesson_id": "lab-measurement-4",
      "front": "Weighing by difference",
      "back": "Weigh the closed container before and after removing sample; the difference is what left it.",
      "objective_ids": [
        "lab-measurement-4-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-4-card-4",
      "lesson_id": "lab-measurement-4",
      "front": "Warm objects on a balance",
      "back": "Read light because of convection; equilibrate to room temperature first.",
      "objective_ids": [
        "lab-measurement-4-objective-4"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-5-card-1",
      "lesson_id": "lab-measurement-5",
      "front": "Nernst slope",
      "back": "RT ln10/F: 59.16 mV per pH at 25 °C, 61.54 at 37 °C.",
      "objective_ids": [
        "lab-measurement-5-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-5-card-2",
      "lesson_id": "lab-measurement-5",
      "front": "Calibration slope",
      "back": "ΔmV/ΔpH between buffers, as a percentage of theoretical; commonly accepted within about 95–105%.",
      "objective_ids": [
        "lab-measurement-5-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-5-card-3",
      "lesson_id": "lab-measurement-5",
      "front": "Henderson–Hasselbalch",
      "back": "pH = pKa + log₁₀([base]/[acid]); a starting point that must be checked with a meter.",
      "objective_ids": [
        "lab-measurement-5-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-5-card-4",
      "lesson_id": "lab-measurement-5",
      "front": "ATC versus buffer temperature",
      "back": "ATC corrects the electrode slope; the buffer's pKa still shifts (Tris about −0.028 per °C).",
      "objective_ids": [
        "lab-measurement-5-objective-4"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-6-card-1",
      "lesson_id": "lab-measurement-6",
      "front": "Absorbance",
      "back": "A = −log₁₀ T; A = 1 transmits 10%, A = 2 transmits 1%.",
      "objective_ids": [
        "lab-measurement-6-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-6-card-2",
      "lesson_id": "lab-measurement-6",
      "front": "Beer–Lambert law",
      "back": "A = ε l c for a dilute solution of one absorber; it fails at high concentration and absorbance.",
      "objective_ids": [
        "lab-measurement-6-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-6-card-3",
      "lesson_id": "lab-measurement-6",
      "front": "Residual pattern",
      "back": "Systematic residuals mean the model is wrong for the range, even if the fit statistic looks high.",
      "objective_ids": [
        "lab-measurement-6-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-6-card-4",
      "lesson_id": "lab-measurement-6",
      "front": "Above the top standard",
      "back": "Dilute into range, re-measure and multiply by the dilution factor; do not extrapolate.",
      "objective_ids": [
        "lab-measurement-6-objective-4"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-project-1",
      "lesson_id": "lab-measurement-project-guide",
      "front": "Qualifying a reagent and an assay",
      "back": "Record the recipe and calculation, the instrument checks with verdicts, the pH calibration decision, the usable curve range with residuals, and each result with its dilution factor.",
      "objective_ids": [
        "lab-measurement-6-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-measurement-project-2",
      "lesson_id": "lab-measurement-project-guide",
      "front": "Calibration buffers for a target pH",
      "back": "Bracket the target: for pH 7.40, calibrate with pH 7.00 and 10.01, not only 4.01 and 7.00.",
      "objective_ids": [
        "lab-measurement-5-objective-1"
      ],
      "license": "CC-BY-4.0"
    }
  ]
}
