      "lesson_id": "materials-engineering-fabrication-1",
      "front": "Hard constraints before preferences",
      "back": "Screen mandatory load, temperature, media, wear, lifecycle and evidence constraints before cost or throughput preferences; never waive failure with a score.",
      "objective_ids": [
        "materials-engineering-fabrication-1-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-1-card-2",
      "lesson_id": "materials-engineering-fabrication-1",
      "front": "Bottleneck and lifecycle accounting",
      "back": "Good throughput uses bottleneck capacity multiplied by declared yield. Annual and lifecycle models require explicit boundaries and units.",
      "objective_ids": [
        "materials-engineering-fabrication-1-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-1-card-3",
      "lesson_id": "materials-engineering-fabrication-1",
      "front": "Uncertainty stays visible",
      "back": "Unknown media, wear, fatigue, joining or supplier evidence remains unknown; sensitivity and qualified engineering/safety review stay open.",
      "objective_ids": [
        "materials-engineering-fabrication-1-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-2-card-1",
      "lesson_id": "materials-engineering-fabrication-2",
      "front": "Processing changes structure and defects",
      "back": "Heat treatment, forming, residual stress, porosity, cure and fiber orientation create conditional property hypotheses, not operating recipes.",
      "objective_ids": [
        "materials-engineering-fabrication-2-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-2-card-2",
      "lesson_id": "materials-engineering-fabrication-2",
      "front": "Signed and model-specific arithmetic",
      "back": "Property increase uses the initial mean; residual stresses add with signs; the square-law porosity example is only a stipulated model.",
      "objective_ids": [
        "materials-engineering-fabrication-2-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-2-card-3",
      "lesson_id": "materials-engineering-fabrication-2",
      "front": "Scatter needs independent evidence",
      "back": "Repeated readings are not independent parts. Nominal means do not define lot distributions, tails, stability or qualification.",
      "objective_ids": [
        "materials-engineering-fabrication-2-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-3-card-1",
      "lesson_id": "materials-engineering-fabrication-3",
      "front": "Compare process mechanisms",
      "back": "Machining, casting, forming, molding, additive and powder-sintering differ in geometry, defects, volume, secondary steps and inspection needs.",
      "objective_ids": [
        "materials-engineering-fabrication-3-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-3-card-2",
      "lesson_id": "materials-engineering-fabrication-3",
      "front": "Joining is architectural evidence",
      "back": "Welding and adhesive joining require distortion, interface, aging/cure, inspection and qualification evidence from the start.",
      "objective_ids": [
        "materials-engineering-fabrication-3-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-3-card-3",
      "lesson_id": "materials-engineering-fabrication-3",
      "front": "Process-plan logic, not settings",
      "back": "DFM/DFA links dependencies, yields, cost models, access and evidence handoffs without CNC paths, weld parameters or machine setups.",
      "objective_ids": [
        "materials-engineering-fabrication-3-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-4-card-1",
      "lesson_id": "materials-engineering-fabrication-4",
      "front": "Datums and geometric function",
      "back": "Ordered datum references link function and inspection. Size alone does not establish axis location, form or assembly suitability.",
      "objective_ids": [
        "materials-engineering-fabrication-4-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-4-card-2",
      "lesson_id": "materials-engineering-fabrication-4",
      "front": "Worst case versus RSS",
      "back": "Worst case sums unfavorable limits. RSS combines compatible variance-like terms only with declared independence; the two are distinct.",
      "objective_ids": [
        "materials-engineering-fabrication-4-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-4-card-3",
      "lesson_id": "materials-engineering-fabrication-4",
      "front": "Stacks affect inspection",
      "back": "Fits and stacks influence datum, assembly and measurement requirements. A numerical stack is not drawing approval or release.",
      "objective_ids": [
        "materials-engineering-fabrication-4-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-5-card-1",
      "lesson_id": "materials-engineering-fabrication-5",
      "front": "Resolution is not accuracy",
      "back": "Resolution, bias, repeatability and reproducibility are different. Gauge R&R needs multiple parts and repeated readings under a declared design.",
      "objective_ids": [
        "materials-engineering-fabrication-5-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-5-card-2",
      "lesson_id": "materials-engineering-fabrication-5",
      "front": "Stability before capability",
      "back": "Rational subgroups and control charts concern process behavior. Cp/Cpk is withheld for unstable or improperly pooled processes.",
      "objective_ids": [
        "materials-engineering-fabrication-5-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-5-card-3",
      "lesson_id": "materials-engineering-fabrication-5",
      "front": "Yield and traceability",
      "back": "Observed yield = accepted/inspected×100 with explicit counting rules. Link part, lot, revision, gauge, subgroup and nonconformance records.",
      "objective_ids": [
        "materials-engineering-fabrication-5-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-6-card-1",
      "lesson_id": "materials-engineering-fabrication-6",
      "front": "Controlled definition and change",
      "back": "Drawing/BOM revisions, supplier/process changes and affected risk, qualification and inspection evidence must remain aligned.",
      "objective_ids": [
        "materials-engineering-fabrication-6-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-6-card-2",
      "lesson_id": "materials-engineering-fabrication-6",
      "front": "Evidence coverage is not closure",
      "back": "First-article percentages leave unverified characteristics open. Nonconformance closure requires verification, not a hidden or deleted row.",
      "objective_ids": [
        "materials-engineering-fabrication-6-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "materials-engineering-fabrication-6-card-3",
      "lesson_id": "materials-engineering-fabrication-6",
      "front": "Only bounded dispositions",
      "back": "synthetic_review_complete means all fictional gates pass; evidence_gaps_remain means hold. Neither is production_approved.",
      "objective_ids": [
        "materials-engineering-fabrication-6-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
