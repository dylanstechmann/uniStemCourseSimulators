      "lesson_id": "lab-biosafety-1",
      "front": "Routes of laboratory-associated infection",
      "back": "Sharps, splashes, mouth pipetting, bites and scratches, and aerosols; most infections have no identified incident.",
      "objective_ids": [
        "lab-biosafety-1-objective-2"
      ],
      "license": "CC-BY-4.0"
