      "objective_ids": [
        "lab-biosafety-3-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "lab-biosafety-3-card-2",
      "lesson_id": "lab-biosafety-3",
      "front": "Class II types",
