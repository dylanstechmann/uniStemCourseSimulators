# Development needs no credentials or .env; Compose generates a local secret.
COURSELAB_PORT=8080
# Existing installations: pin their original Compose project identity before upgrading.
# This preserves existing database/credential volumes. See docs/DEPLOYMENT.md.
# COMPOSE_PROJECT_NAME=
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional mutation thresholds per network peer per rolling minute.
# COURSELAB_RATE_LIMIT=120
# COURSELAB_AUTH_RATE_LIMIT=30
# Production only: set your domain and path to an untracked password file.
COURSELAB_DOMAIN=
DB_PASSWORD_FILE=
# Separate PostgreSQL password used by the API's least-privilege runtime role.
DB_RUNTIME_PASSWORD_FILE=
# Optional initial production resource caps; tune with deployment load tests.
COURSELAB_API_MEMORY_LIMIT=1g
COURSELAB_API_CPUS=1.0
COURSELAB_DB_MEMORY_LIMIT=2g
COURSELAB_DB_CPUS=2.0
COURSELAB_MIGRATE_MEMORY_LIMIT=2g
COURSELAB_MIGRATE_CPUS=1.0
# Optional protected assessment source directory; keep it outside Git and mount read-only.
COURSELAB_PRIVATE_ASSESSMENTS_PATH=./.local/private-assessments
# Optional production secret to keep signed formative variant tokens valid across API restarts.
# Generate a random value of at least 32 bytes; do not commit the real value.
VARIANT_TOKEN_SECRET=replace-with-a-random-value-at-least-32-bytes
# No provider credentials are needed; LLM feedback is not implemented.
